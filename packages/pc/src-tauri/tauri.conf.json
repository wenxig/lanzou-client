{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lanzou-client",
  "version": "0.1.0",
  "identifier": "com.wenxig.lanzou-client",
  "build": {
    "beforeDevCommand": "vp run pc#dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "vp run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "lanzou-client",
        "width": 800,
        "height": 600,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}